NODE_ENV=development
AUTH_REQUESTS_PER_WINDOW=12
PORT=5000
DATABASE_URL=postgresql://postgres.project_ref:password@pooler-host:6543/postgres?sslmode=require
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
# Google OAuth 2.0 Web client ID. This is public configuration, not a secret.
# GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# Required to accept Seller requests containing CNIC numbers. Keep the same key
# across deployments and backups; losing it makes stored CNIC values unreadable.
# Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# SELLER_REQUEST_ENCRYPTION_KEY=64-character-hex-key
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
## Uncomment and fill both Gmail settings for real verification/invitations.
# GMAIL_USER=your.account@gmail.com
# GMAIL_APP_PASSWORD=your-16-character-google-app-password
EMAIL_FROM_NAME=ReThread

# Direct local API: 0. Set the exact trusted proxy count for your host.
TRUST_PROXY_HOPS=0
DATABASE_POOL_MAX=5
PUBLIC_READS_PER_MINUTE=300

# RapidGateway hosted checkout. Keep TEST mode for local/sandbox work.
# Both the TEST merchant ID and TEST webhook signing salt are required to start
# checkout. Register a public HTTPS URL ending in /api/v1/rapidgateway/webhook
# under the TEST webhook settings and copy that environment's signing salt.
# TEST mode uses the provider's shared sandbox OAuth client; do not set a live
# client secret for TEST.
RAPID_GATEWAY_MODE=TEST
# RAPID_GATEWAY_MERCHANT_ID=your-test-merchant-id
# RAPID_GATEWAY_WEBHOOK_SECRET=your-test-webhook-signing-salt
# Switch to LIVE only after provider approval. Supply the LIVE merchant ID,
# client secret and LIVE webhook signing salt. Never expose these in the frontend.
# RAPID_GATEWAY_MODE=LIVE
# RAPID_GATEWAY_CLIENT_SECRET=your-live-client-secret

# Optional images: set all three backend-only values, then npm run storage:setup.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-backend-only-service-role-key
# LISTING_IMAGE_BUCKET=listing-images

# Backend-only random secret (32-256 characters) for authenticated Vercel cleanup.
# CRON_SECRET=generate-your-own-random-secret

# Optional synthetic seed; never enable for production. No default password.
# ALLOW_DEMO_SEED=true
# DEMO_PASSWORD=choose-your-own-strong-password

# Integration tests use a separate local database named resourcepk_test_*.
# Never point this at the app database; integration setup writes test fixtures.
# TEST_DATABASE_URL=postgresql://postgres:your-local-password@127.0.0.1:55432/resourcepk_test_local
